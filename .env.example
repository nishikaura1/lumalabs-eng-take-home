# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2

# --- Added for this solution (Styled Shots) ---
# LUMA_AGENTS_API_KEY comes from .env.local, already provided with the challenge.

# Telegram bot: create via @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=xxxxx
# The single group chat id Ellie + Maya are both in (bot must be a member).
# Easiest way to get it: message the bot, then hit
# https://api.telegram.org/bot<token>/getUpdates and read "chat":{"id": ...}
TELEGRAM_CHAT_ID=xxxxx

# Postgres connection string (Railway/Neon free tier both work).
DATABASE_URL=postgres://user:pass@host:5432/dbname

# S3 bucket for generated images (stand-in for the customer's drive folder —
# see APPROACH.md Scope Ledger). Uses the AWS_* credentials above.
S3_BUCKET_NAME=styled-shots-xxxxx

# Optional tuning, sane defaults if omitted:
# LUMA_MODEL=uni-1
# WORKER_POLL_INTERVAL_MS=15000
# WORKER_BATCH_SIZE=3
# VARIANTS_PER_REQUEST=3
# WORKER_MAX_PENDING_REVIEWS=15
# PORT=3000
# TEAM_TIMEZONE=America/Los_Angeles   # unverified assumption, display-only today
