# Rename to .env and fill in any keys your solution needs.
# We have accounts with these providers and will supply real keys when reviewing.

ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
ELEVEN_LABS_API_KEY=xxxxx
GOOGLE_CLOUD_API_KEY=xxxxx
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-west-2

# --- Added for this solution (Styled Shots) ---
# LUMA_AGENTS_API_KEY comes from .env.local, already provided with the challenge.

# Telegram bot: create via @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=xxxxx
# The single group chat id Ellie + Maya are both in (bot must be a member).
# Easiest way to get it: message the bot, then hit
# https://api.telegram.org/bot<token>/getUpdates and read "chat":{"id": ...}
TELEGRAM_CHAT_ID=xxxxx
# Ellie's Telegram user id -- the only user allowed to approve/reject/undo/
# redo or import a CSV. Get it the same way as above, from a message she
# sends (look at "from":{"id": ...} instead of "chat").
TELEGRAM_ELLIE_USER_ID=xxxxx

# Postgres connection string (Railway/Neon free tier both work).
DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=require   # set this once pointed at a hosted Postgres (Railway/Neon/Render) -- self-signed certs

# S3 bucket for generated images (stand-in for the customer's drive folder —
# see APPROACH.md Scope Ledger). Uses the AWS_* credentials above.
S3_BUCKET_NAME=styled-shots-xxxxx
# Local dev only: point at a MinIO instance instead of real S3 (no AWS
# credentials needed yet -- see README "we'll supply real keys when
# reviewing"). Unset both for real AWS S3.
#   brew install minio && MINIO_ROOT_USER=styledshots MINIO_ROOT_PASSWORD=styledshots-local-dev minio server --address :9000 /usr/local/var/minio-data
#   npm run setup:minio-bucket
# S3_ENDPOINT=http://localhost:9000

# Optional tuning, sane defaults if omitted:
# LUMA_MODEL=uni-1
# WORKER_POLL_INTERVAL_MS=15000
# WORKER_BATCH_SIZE=3
# VARIANTS_PER_REQUEST=3
# WORKER_MAX_PENDING_REVIEWS=15
# PORT=3000
# TEAM_TIMEZONE=America/Los_Angeles   # unverified assumption — see ASSUMPTIONS.md
# WORK_HOURS_START=9                  # 24h, local to TEAM_TIMEZONE
# WORK_HOURS_END=18
# WORK_DAYS=1,2,3,4,5                 # 0=Sun..6=Sat, default Mon-Fri
# NOTIFIER_POLL_INTERVAL_MS=20000
# NOTIFIER_BATCH_SIZE=5                # photos sent per tick, trickled not dumped
# CRITICAL_FAILURE_TICK_THRESHOLD=2    # consecutive all-failed batches before a systemic-failure alert
# QUALITY_SCREEN_MODEL=claude-haiku-4-5-20251001  # uses ANTHROPIC_API_KEY above; unset key = screening skipped, not blocking
